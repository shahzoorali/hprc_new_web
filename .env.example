# Admin dashboard — server-only secrets (Next.js / Vercel).
# Copy to .env.local for local dev and set real values in Vercel for prod.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# Password for the /admin login form.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin_session JWT. Use a long random string.
# Generate one e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Shared token sent as X-Admin-Token to the PHP admin API. Must match the
# ADMIN_API_TOKEN set on the PHP host.
ADMIN_API_TOKEN=change-me

# Base URL of the PHP payment app (no trailing slash).
#   prod: https://hprc.in/payment
#   dev:  http://localhost:8000/payment
PAYMENT_API_BASE=http://localhost:8000/payment
