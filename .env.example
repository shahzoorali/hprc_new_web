# Admin dashboard — server-only secrets (Next.js / Vercel).
# Copy to .env.local for local dev and set real values in Vercel for prod.
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# Password for the /admin login form.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin_session JWT. Use a long random string.
# Generate one e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Shared token sent as X-Admin-Token to the PHP admin API. Must match the
# ADMIN_API_TOKEN set on the PHP host.
ADMIN_API_TOKEN=change-me

# Base URL of the PHP payment app (no trailing slash).
#   prod: https://hprc.in/payment
#   dev:  http://localhost:8000/payment
PAYMENT_API_BASE=http://localhost:8000/payment

# --- Payload CMS ---
# MongoDB connection string for CMS content. Production uses a MongoDB Atlas
# cluster in ap-south-1 (same region as the EC2 box). Include the database name
# in the path — Payload does not add one.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hprc_cms?retryWrites=true&w=majority
DATABASE_URI=mongodb://127.0.0.1:27017/hprc_cms

# Signs Payload session tokens and encrypts stored credentials. Long + random.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every logged-in CMS session.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: offsite destination for scripts/backup-mongo.sh. Atlas shared tiers
# (M0/M2/M5) have NO automated snapshots, so this is the real backup.
# BACKUP_S3_URI=s3://your-bucket/hprc-cms
